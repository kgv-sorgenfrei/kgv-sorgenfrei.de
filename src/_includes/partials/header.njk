<header class="sticky top-0 z-40 border-b border-leaf-800/10 bg-stone-50/95 backdrop-blur">
  <div class="container-page flex items-center justify-between gap-4 py-3">
    <a href="/" class="flex items-center gap-3 shrink-0">
      <img src="/assets/images/logo.svg" alt="{{ site.fullName }} – Logo" class="h-14 w-auto sm:h-16">
      <span class="flex flex-col leading-tight">
        <span class="font-display text-base font-semibold text-leaf-800 sm:text-lg">{{ site.name }}</span>
        <span class="text-xs font-medium uppercase tracking-wide text-coal-500">seit {{ site.founded }}</span>
      </span>
    </a>

    <nav aria-label="Hauptnavigation" class="hidden lg:block">
      <ul class="flex flex-wrap items-center gap-1 text-sm font-semibold">
        {% for item in site.nav %}
        <li>
          <a
            href="{{ item.url }}"
            class="rounded-sm px-3 py-2 text-coal-700 hover:bg-leaf-50 hover:text-leaf-700 {% if page.url == item.url %}bg-leaf-50 text-leaf-700{% endif %}"
          >{{ item.title }}</a>
        </li>
        {% endfor %}
      </ul>
    </nav>

    <button
      type="button"
      id="nav-toggle"
      class="inline-flex items-center justify-center rounded-sm p-2 text-leaf-800 lg:hidden"
      aria-expanded="false"
      aria-controls="mobile-nav"
    >
      <span class="sr-only">Menü öffnen</span>
      <svg id="icon-menu" class="h-7 w-7" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.75">
        <path stroke-linecap="round" stroke-linejoin="round" d="M3.75 6.75h16.5M3.75 12h16.5M3.75 17.25h16.5" />
      </svg>
      <svg id="icon-close" class="hidden h-7 w-7" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.75">
        <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" />
      </svg>
    </button>
  </div>

  <nav id="mobile-nav" aria-label="Mobile Navigation" class="hidden border-t border-leaf-800/10 bg-stone-50 lg:hidden">
    <ul class="container-page flex flex-col py-2 text-base font-semibold">
      {% for item in site.nav %}
      <li>
        <a href="{{ item.url }}" class="block rounded-sm px-3 py-3 text-coal-700 hover:bg-leaf-50 hover:text-leaf-700 {% if page.url == item.url %}text-leaf-700{% endif %}">
          {{ item.title }}
        </a>
      </li>
      {% endfor %}
    </ul>
  </nav>
</header>
