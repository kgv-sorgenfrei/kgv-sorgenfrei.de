{
  "name": "kgv-sorgenfrei",
  "version": "1.0.0",
  "description": "Website des Kleingartenvereins Sorgenfrei e.V.",
  "private": true,
  "license": "UNLICENSED",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "npm run build:css && eleventy",
    "build:prod": "cross-env ELEVENTY_ENV=production npm run build:css:prod && cross-env ELEVENTY_ENV=production eleventy",
    "serve": "npm run build:css && cross-env ELEVENTY_ENV=development eleventy --serve",
    "serve:prod": "npm run build:prod && serve _site -l 8080",
    "build:css": "tailwindcss -i ./src/assets/css/tailwind.css -o ./src/assets/css/style.css",
    "build:css:prod": "tailwindcss -i ./src/assets/css/tailwind.css -o ./src/assets/css/style.css --minify",
    "watch:css": "tailwindcss -i ./src/assets/css/tailwind.css -o ./src/assets/css/style.css --watch",
    "clean": "rm -rf _site"
  },
  "devDependencies": {
    "@11ty/eleventy": "^3.0.0",
    "@11ty/eleventy-img": "^7.0.0",
    "cross-env": "^7.0.3",
    "html-minifier-terser": "^7.2.0",
    "serve": "^14.2.3",
    "tailwindcss": "^3.4.13"
  },
  "allowScripts": {
    "sharp@0.33.5": true
  }
}
